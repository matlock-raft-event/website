---
import { cancellationUpdateLink, eventYear, isCancelled } from "~/lib/event";
import { getEvent } from "~/lib/get-event";

/* Shown on every page while the Studio's Event status is Cancelled. It states
   the fact; the Update it links to gives the details. */
const event = await getEvent();
const link = cancellationUpdateLink(event);
---
{isCancelled(event) && (
    <div class="bg-raft px-4 py-3 text-center text-sm text-raft-contrast sm:text-base">
        <strong class="font-semibold">The {eventYear(event)} Matlock Raft Event is cancelled.</strong>
        {" "}
        <a
            class="underline underline-offset-2 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
            href={link.href}
        >
            {link.label}
        </a>
    </div>
)}
