---
import { getImage } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import HeaderImg from "~/assets/images/header.jpg";
import takePartImg from "~/assets/images/take-part-img.jpg";
import helpOutImg from "~/assets/images/help-out-img.jpg";
import donateImg from "~/assets/images/donate-img.jpg";
import sponsorUsImg from "~/assets/images/sponsor-us-img.jpg";
import IndexPage from "~/page-content/index-page";
import { sanityClient } from "~/lib/sanity";
import {
    heroQuery,
    summaryQuery,
    winnersQuery,
    updatesQuery,
} from "~/lib/queries";
import { cancellationUpdateLink, eventStart, eventYear, isCancelled } from "~/lib/event";
import { getEvent } from "~/lib/get-event";
import type {
    HeroQueryResult,
    SummaryQueryResult,
    WinnersQueryResult,
    UpdatesQueryResult,
} from "~/lib/sanity.types";

const [hero, summary, winners, updates, event] = await Promise.all([
    sanityClient.fetch<HeroQueryResult>(heroQuery),
    sanityClient.fetch<SummaryQueryResult>(summaryQuery),
    sanityClient.fetch<WinnersQueryResult>(winnersQuery),
    sanityClient.fetch<UpdatesQueryResult>(updatesQuery),
    getEvent(),
]);

const heroImage = await getImage({
    src: HeaderImg,
    format: "webp",
    widths: [640, 1024, 1600, 2400],
    sizes: "100vw",
});

/* The Get Involved cards are a quarter of a 1024px row at most, so webp at
   these widths replaces ~3.3MB of raw JPEG with a fraction of it. */
const getInvolvedImages = await Promise.all(
    [takePartImg, helpOutImg, donateImg, sponsorUsImg].map(async (src) => {
        const img = await getImage({
            src,
            format: "webp",
            widths: [320, 480, 720],
            sizes: "(min-width: 960px) 240px, (min-width: 600px) 45vw, 90vw",
        });

        return { src: img.src, srcSet: img.srcSet.attribute };
    })
);

const cancelled = isCancelled(event);
const eventJsonLd = {
    "@context": "https://schema.org",
    "@type": "Event",
    name: `The Matlock Raft Event ${eventYear(event)}`,
    startDate: eventStart(event).toISOString(),
    // Google shows a cancelled event as cancelled in search results
    eventStatus: cancelled
        ? "https://schema.org/EventCancelled"
        : "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
        "@type": "Place",
        name: "River Derwent, Matlock",
        address: {
            "@type": "PostalAddress",
            addressLocality: "Matlock",
            addressRegion: "Derbyshire",
            addressCountry: "GB",
        },
    },
    image: new URL("og-image.jpg", Astro.site).href,
    description:
        "The annual Boxing Day charity raft race down the River Derwent from Matlock to Cromford, raising money for the RNLI. Free to watch and family friendly.",
    isAccessibleForFree: true,
    organizer: {
        "@type": "Organization",
        name: "The Matlock Raft Event",
        url: Astro.site?.href,
    },
};
---
<BaseLayout
    title="The Matlock Raft Event — Boxing Day charity raft race"
    description="Join Matlock's annual charity raft race on the River Derwent every Boxing Day, raising money for the RNLI. Enter a raft, donate, sponsor, or come and watch."
    jsonLd={[eventJsonLd]}
    overlayHeader
>
    <IndexPage
        client:load
        hero={hero}
        summary={summary}
        winners={winners}
        updates={updates}
        heroImageSrc={heroImage.src}
        heroImageSrcset={heroImage.srcSet.attribute}
        getInvolvedImages={getInvolvedImages}
        eventDate={event?.date ?? undefined}
        cancellation={cancelled
            ? { year: eventYear(event), ...cancellationUpdateLink(event) }
            : undefined}
    />
</BaseLayout>
