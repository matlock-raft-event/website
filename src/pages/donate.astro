---
import BaseLayout from "~/layouts/BaseLayout.astro";
import DonatePage from "~/page-content/donate-page";
import { eventYear } from "~/lib/event";
import { getEvent } from "~/lib/get-event";

const event = await getEvent();
---
<BaseLayout
    description="Donate to the Matlock Raft Event and help us raise more than ever for the RNLI."
    title="Donate - Matlock Raft Event"
>
    <DonatePage client:load donationUrl={event?.donationUrl ?? undefined} year={eventYear(event)} />
</BaseLayout>
