---
import BaseLayout from "~/layouts/BaseLayout.astro";
import DonatePage from "~/page-content/donate-page";
import { sanityClient } from "~/lib/sanity";
import { donationQuery } from "~/lib/queries";
import type { DonationQueryResult } from "~/lib/sanity.types";

const donation = await sanityClient.fetch<DonationQueryResult>(donationQuery);
---
<BaseLayout
    description="Donate to the Matlock Raft Event and help us raise more than ever for the RNLI."
    title="Donate - Matlock Raft Event"
>
    <DonatePage client:load donation={donation} />
</BaseLayout>
