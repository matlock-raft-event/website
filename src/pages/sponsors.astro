---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SponsorsPage from "~/page-content/sponsors-page";
import { sanityClient } from "~/lib/sanity";
import { sponsorsQuery, sponsorTestimonialsQuery } from "~/lib/queries";
import type { SponsorsQueryResult, SponsorTestimonialsQueryResult } from "~/lib/sanity.types";

const [sponsors, testimonials] = await Promise.all([
    sanityClient.fetch<SponsorsQueryResult>(sponsorsQuery),
    sanityClient.fetch<SponsorTestimonialsQueryResult>(sponsorTestimonialsQuery),
]);
---
<BaseLayout
    description="Explore the valued sponsors who have contributed to the success of the event. The Matlock Raft Event would not be possible without their support."
    title="Our Event Sponsors - Matlock Raft Event"
>
    <SponsorsPage client:load sponsors={sponsors} testimonials={testimonials} />
</BaseLayout>
