---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { sanityClient, urlFor } from "~/lib/sanity";
import { updatesForPathsQuery } from "~/lib/queries";
import type { UpdatesForPathsQueryResult } from "~/lib/sanity.types";
import SingleUpdatePage from "~/page-content/single-update-page";

type UpdateDoc = UpdatesForPathsQueryResult[number];

export async function getStaticPaths() {
    const updates = await sanityClient.fetch<UpdatesForPathsQueryResult>(updatesForPathsQuery);

    return updates.map((update) => ({
        params: { slug: update.slug },
        props: { update },
    }));
}

const { update } = Astro.props as { update: UpdateDoc };
const title = `${update.title ?? "Update"} - Matlock Raft Event`;

const toPlainText = (blocks: unknown): string =>
    Array.isArray(blocks)
        ? blocks
              .filter((block) => block?._type === "block" && Array.isArray(block.children))
              .map((block) => block.children.map((child: { text?: string }) => child.text ?? "").join(""))
              .join(" ")
        : "";

const truncate = (text: string, max = 155): string =>
    text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text;

const plainContent = toPlainText(update.content).replace(/\s+/g, " ").trim();
const description = plainContent
    ? truncate(plainContent)
    : `${update.title ?? "An update"} — the latest news from The Matlock Raft Event, the Boxing Day charity raft race for the RNLI.`;

const ogImage = update.img
    ? urlFor(update.img).width(1200).height(630).fit("crop").url()
    : undefined;

const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: update.title ?? "Update",
    description,
    ...(update.date ? { datePublished: update.date } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    author: { "@type": "Organization", name: "The Matlock Raft Event" },
    publisher: {
        "@type": "Organization",
        name: "The Matlock Raft Event",
        url: Astro.site?.href,
    },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout
    description={description}
    title={title}
    ogImage={ogImage}
    ogImageAlt={ogImage ? (update.title ?? "Matlock Raft Event update") : undefined}
    ogType="article"
    jsonLd={[articleJsonLd]}
>
    <SingleUpdatePage client:load update={update} />
</BaseLayout>
