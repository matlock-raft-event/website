---
import BaseLayout from "~/layouts/BaseLayout.astro";
import TheRacePage from "~/page-content/the-race-page";
import { eventFacts } from "~/lib/event";
import { getEvent } from "~/lib/get-event";

const facts = eventFacts(await getEvent());
---
<BaseLayout
    description="The Matlock Raft Event route and timings — see where the rafts go down the River Derwent and what happens when on Boxing Day."
    title="The Race - Matlock Raft Event"
>
    <TheRacePage client:load facts={facts} />
</BaseLayout>
