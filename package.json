{
  "name": "raft-event-app-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-sponsor-strip.mjs && NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "preview": "pnpm run build && wrangler dev",
    "astro": "astro",
    "typecheck": "astro check",
    "trim-logos": "cd studio && npx sanity exec ../scripts/trim-logos.ts --with-user-token && cd .. && node scripts/generate-sponsor-strip.mjs",
    "sanity:schema": "sanity schema extract --path ./schema.json --force",
    "sanity:typegen": "pnpm sanity:schema && sanity typegen generate",
    "generate-types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "^4.1.1",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.25.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.33.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "groq": "^6.25.0",
    "sanity": "^6.25.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@9.0.0",
  "overrides": {
    "vite": "^8"
  }
}
